/* Editerako light theme — same selectors as dark.qss, light palette. */

QMainWindow {
    background-color: #f3f3f3;
    color: #1e1e1e;
}

QMenuBar {
    background-color: #e8e8e8;
    color: #1e1e1e;
}

QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
}

QMenu::item:selected {
    background-color: #cce8ff;
}

QToolBar {
    background-color: #e8e8e8;
    border: 1px solid #d0d0d0;
    spacing: 15px;
    height: 40px;
}

QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e8e8e8;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    padding: 8px 16px;
    margin-right: 0px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 1px solid #ffffff;
}

QTreeWidget, QTreeView {
    background-color: #f8f8f8;
    border: 1px solid #d0d0d0;
    color: #1e1e1e;
    alternate-background-color: #ffffff;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #cce8ff;
}

QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: none;
    font-family: "Monaco", "Consolas", monospace;
    font-size: 13px;
    line-height: 1.4;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #adadad;
    border-radius: 4px;
    color: #1e1e1e;
    padding: 6px;
}

QPushButton {
    background-color: #e8e8e8;
    border: 1px solid #adadad;
    border-radius: 4px;
    color: #1e1e1e;
    padding: 6px 12px;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #d8d8d8;
}

QPushButton#fixButton,
QPushButton#inviteButton {
    background-color: #6a9955;
    color: white;
    font-weight: bold;
    border: none;
}

QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 20px;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #adadad;
    border-radius: 4px;
    color: #1e1e1e;
    padding: 4px 8px;
}

QComboBox::drop-down {
    border: none;
}

QLabel {
    color: #1e1e1e;
}

QStatusBar {
    background-color: #e8e8e8;
    border-top: 1px solid #d0d0d0;
    color: #1e1e1e;
}

QDialog, QMessageBox {
    background-color: #ffffff;
    color: #1e1e1e;
}

QCheckBox {
    color: #1e1e1e;
}
